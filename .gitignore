# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.uv/

# pytest
.pytest_cache/

# ruff / ty caches
.ruff_cache/

# Terraform (matches at repo root and inside examples/*/ alike)
.tflint.d/
.build/
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
